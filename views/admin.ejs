<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Dashboard</title>

    <link rel="stylesheet" href="/styles.css">
</head>

<body class="page-admin">

    <%- include('partials/header', {
        pageTitle: 'Admin Dashboard',
        role: 'admin'
    }) %>

    <main>

        <h2>Registered Users</h2>

        <% if (users.length === 0) { %>

            <p>No users registered.</p>

        <% } else { %>

            <table>

                <thead>

                    <tr>
                        <th>Username</th>
                        <th>Role</th>
                        <th>Join Date</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    <% users.forEach((user) => { %>

                        <tr>

                            <td>
                                <%= user.username %>
                            </td>

                            <td>
                                <%= user.role %>
                            </td>

                            <td>
                                <%= new Date(
                                    user.createdAt
                                ).toLocaleDateString() %>
                            </td>

                            <td>

                                <a href="/profile/<%= user._id %>">
                                    View Profile
                                </a>

                                <% if (
                                    user._id.toString() !== userId
                                ) { %>

                                    <form
                                        action="/admin/users/<%= user._id %>/delete"
                                        method="post"
                                    >

                                        <button type="submit">
                                            Remove
                                        </button>

                                    </form>

                                <% } else { %>

                                    <span class="current-admin">
                                        Current Admin
                                    </span>

                                <% } %>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        <% } %>

    </main>

</body>

</html>
