<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Socket Chat</title>
</head>
<body>

    <div class="main-content">
        <h1>Welcome to the Socket Chat</h1>

        <p>
            Users Online:
            <span id="online-users"><%= onlineUsers %></span>
        </p>

        <p>Please log in or create an account to continue.</p>

        <p>
            <a href="/login">
                <button type="button">Log In</button>
            </a>

            <a href="/signup">
                <button type="button">Sign Up</button>
            </a>
        </p>
    </div>

    <script>
        async function updateOnlineCount() {
            try {
                const response = await fetch('/online-count');

                if (!response.ok) {
                    throw new Error('Failed to fetch online user count.');
                }

                const data = await response.json();

                document.getElementById('online-users').textContent =
                    data.onlineUsers;
            } catch (error) {
                console.error('Online count error:', error);
            }
        }

        updateOnlineCount();

        setInterval(updateOnlineCount, 2000);
    </script>

</body>
</html>
