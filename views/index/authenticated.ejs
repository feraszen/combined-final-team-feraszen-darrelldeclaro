<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Chat</title>
</head>
<body>

    <%- include('../partials/header', {
        pageTitle: 'Live Chat',
        role: role
    }) %>

    <main>

        <section>
            <h2>Users Online</h2>

            <p id="connection-status">Connecting...</p>

            <ul id="user-list"></ul>
        </section>

        <hr>

        <section>
            <h2>Chat Messages</h2>

            <div
                id="chat-messages"
                style="
                    border: 1px solid #ccc;
                    padding: 10px;
                    height: 400px;
                    overflow-y: auto;
                "
            >
                <% if (messages && messages.length > 0) { %>

                    <% messages.forEach((message) => { %>

                        <div>
                            <strong><%= message.username %>:</strong>

                            <span>
                                <%= message.message %>
                            </span>

                            <small>
                                (<%= new Date(message.timestamp).toLocaleTimeString() %>)
                            </small>
                        </div>

                    <% }) %>

                <% } else { %>

                    <p>No messages yet.</p>

                <% } %>
            </div>
        </section>

        <hr>

        <section>

            <form id="message-form">

                <label for="message-input">
                    Message:
                </label>

                <input
                    type="text"
                    id="message-input"
                    name="message"
                    autocomplete="off"
                    required
                >

                <button type="submit">
                    Send
                </button>

            </form>

        </section>

    </main>

    <script src="/frontend.js"></script>

</body>
</html>